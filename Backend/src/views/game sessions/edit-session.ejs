<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sessions | GameShelf</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <div class="edit-session-page">
    <main class="container">
      <% if (session) { %>
      <form action="/sessions/<%= session.id %>/edit" method="POST">

        <div class="card card-hover">
          <div class="game-box">
            <div class="game-icon">🎲</div>

            <div>
              <h3><%= session.name %></h3>

              <p>
                <strong>Host:</strong>
                <%= session.host %>
              </p>

              <p><strong>Date:</strong> <%= session.date %></p>
              <p>
                <label for="session-date">New date:</label>
              </p>
              <input id="session-date" name="date" type="date" value="<%= session.date %>" required>

              <p><strong>Time:</strong> <%= session.time %></p>
              <p>
                <label for="session-time">New time:</label>
              </p>
              <input id="session-time" name="time" type="time" value="<%= session.time %>" required>

              <p>
                <strong>Place:</strong>
                <%= session.place %>
              </p>

              <label for="session-place">New place:</label>
              <select id="session-place" name="place" required>
                <% places.forEach(place => { %>
                <option value="<%= place %>" <%= session.place === place ? "selected" : "" %>>
                  <%= place %>
                </option>
                <% }) %>
              </select>
            </div>
          </div>
        </div>

        <div class="card card-hover">
          <div class="game-box">
            <div class="game-icon">🎲</div>

            <div>
              <h3>Edit capacity</h3>

              <p>
                <%= confirmedCount %>/<%= session.capacity %>
                Confirmed

                <span class="badge <%= session.status === 'Open' ? 'approved' : 'rejected' %>">
                  <%= session.status %>
                </span>
              </p>

              <label for="session-capacity">
                New capacity:
              </label>
              <input id="session-capacity" name="capacity" type="number" min="2" step="1" value="<%= session.capacity %>" placeholder="Enter new capacity. Min 2" required>

              <p style="color: var(--red);">
                Warning: changing capacity may move members
                onto or off the waiting list.
              </p>
            </div>
          </div>
        </div>

        <div class="card card-hover">
          <div class="game-box">
            <div class="game-icon">🎲</div>

            <div>
              <h3>Edit host</h3>

              <p>Current host: <%= session.host %></p>

              <label for="session-host">New host:</label>
              <select id="session-host" name="host" required>
                <% hosts.forEach(host => { %>
                <option value="<%= host %>" <%= session.host === host ? "selected" : "" %>>
                  <%= host %>
                </option>
                <% }) %>
              </select>
            </div>
          </div>
        </div>

        <% if (error) { %>
        <p class="error" role="alert"><%= error %></p>
        <% } %>

        <div class="flex gap-sm">
          <button type="submit" class="btn btn-primary">
            Save changes
          </button>

          <a href="/sessions/<%= session.id %>" class="btn btn-danger">
            Cancel changes
          </a>
        </div>
      </form>

      <% } else { %>
      <section>
        <h2>Session not found</h2>

        <a href="/sessions" class="btn btn-primary">
          Return to sessions
        </a>
      </section>
      <% } %>
    </main>
  </div>
</body>

</html>