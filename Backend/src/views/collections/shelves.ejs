<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shelves</title>
</head>
<body>
    <h1>My shelves</h1>
    <a href="/collections/add-shelf">Add shelf</a>
    <a href="/collections">Collection</a>
    <br><br>

    <% if (locals.message) { %>
        <%= message %><br><br>
    <% } %>

    <% if (shelves.length > 0 && records.length > 0) { %>
        <form action="/collections/add-to-shelf" method="post">
            <select name="gameId">
                <% records.forEach(record => { %>
                    <option value="<%= record.gameId %>"><%= getGameTitle(record.gameId) %></option>
                <% }) %>
            </select>

            <select name="shelfId">
                <% shelves.forEach(shelf => { %>
                    <option value="<%= shelf.id %>"><%= shelf.name %></option>
                <% }) %>
            </select>

            <input type="submit" value="Add to shelf">
        </form>
        <br>
    <% } %>

    <% if (shelves.length === 0) { %>
        No shelves
    <% } %>

    <% shelves.forEach(shelf => { %>
      <div style="border: 1px solid black; padding: 0.4rem;">
        <strong><a href="/collections/shelf/<%= shelf.id %>"><%= shelf.name %></a></strong><br>
        <%= shelf.description %><br>
        <% if (shelf.isPublic) { %>
            Public
        <% } else { %>
            Private
        <% } %>
        <ul>
            <% shelfGames.forEach(shelfGame => { %>
                <% if (shelfGame.shelfId === shelf.id) { %>
                    <li><%= getGameTitle(shelfGame.gameId) %></li>
                <% } %>
            <% }) %>
        </ul>
      </div>
    <% }) %>
</body>
</html>
