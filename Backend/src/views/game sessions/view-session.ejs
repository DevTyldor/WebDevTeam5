 <!DOCTYPE html>
 <html lang="en">

 <head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>View Session | GameShelf</title>
   <link rel="stylesheet" href="/css/style.css">
 </head>

 <body>

   <div class="view-session-page">
     <main class="container">

       <% if (session) { %>

       <!-- Session details -->
       <section>

         <div class="section-title">
           <div>
             <h2>Session Details</h2>
           </div>

           <div>
             <a href="/sessions" class="btn btn-primary">
               Return to sessions list
             </a>
           </div>
         </div>

         <div class="card card-hover">
           <div class="game-box">

             <div class="game-icon">🎲</div>

             <div>
               <h3><%= session.name %></h3>

               <p><strong>Host:</strong> <%= session.host %></p>
               <p><strong>Date:</strong> <%= session.date %></p>
               <p><strong>Time:</strong> <%= session.time %></p>
               <p><strong>Place:</strong> <%= session.place %></p>
               <p><%= session.description %></p>
             </div>

           </div>
         </div>

         <!-- Capacity and waiting list -->
         <div class="card card-hover attendance-card">

           <div>
             <h4>Capacity</h4>

             <p>
               <%= session.signups.filter(s => s.status === "Confirmed").length %>/<%= session.capacity %>
               Confirmed
             </p>

             <span class="badge <%= session.status === 'Open' ? 'approved' : (session.status === 'Full' || session.status === 'Cancelled' ? 'rejected' : '') %>">
               <%= session.status %>
             </span>
           </div>

           <div class="section-divider">

             <h4>Waiting list</h4>

             <% const waitingSignups = session.signups.filter(s => s.status === "Waiting"); %>

             <% if (waitingSignups.length > 0) { %>

             <ol>
               <% waitingSignups.forEach(signup => { %>
               <li><%= signup.memberId %></li>
               <% }); %>
             </ol>

             <% } else { %>

             <p>No one is currently on the waiting list.</p>

             <% } %>

           </div>
         </div>

         <!-- Games -->
         <div class="card card-hover">

           <div class="game-box">
             <div>
               <h4>Games</h4>

               <% if (session.games.length > 0) { %>

               <ul>
                 <% session.games.forEach(game => { %>

                 <li>
                   <%= game.name %>
                   (<%= game.minPlayers %>–<%= game.maxPlayers %> players)

                   <% if (session.signups.filter(s => s.status === "Confirmed").length >= game.minPlayers) { %>

                   <span class="badge approved">
                     ✓ Enough players
                   </span>

                   <% } %>
                 </li>

                 <% }); %>
               </ul>

               <% } else { %>

               <p>No games have been added to this session.</p>

               <% } %>

             </div>
           </div>

         </div>

         <!-- Confirmed participants -->
         <div class="card card-hover">

           <div class="game-box">
             <div>
               <h4>Confirmed participants</h4>

               <% const confirmedSignups = session.signups.filter(s => s.status === "Confirmed"); %>

               <% if (confirmedSignups.length > 0) { %>

               <ol>
                 <% confirmedSignups.forEach(signup => { %>

                 <li>
                   <%= signup.memberId %>

                   <% if (signup.game) { %>
                   → Bringing <%= signup.game.name %>
                   <% } else { %>
                   → No game selected
                   <% } %>
                 </li>

                 <% }); %>
               </ol>

               <% } else { %>

               <p>No confirmed participants yet.</p>

               <% } %>

             </div>
           </div>

         </div>

         <!-- Actions -->
         <div class="flex gap-sm">

           <% if (session.status !== "Cancelled") { %>

           <a href="/sessions/signup/<%= session.id %>" class="btn btn-primary">
             Sign up
           </a>

           <% } %>

           <a href="/sessions/edit/<%= session.id %>" class="btn btn-primary">
             Edit session
           </a>

           <% if (session.status !== "Cancelled") { %>

           <a href="/sessions/cancel/<%= session.id %>" class="btn btn-danger">
             Cancel session
           </a>

           <% } %>

         </div>

       </section>

       <% } else { %>

       <section>
         <h2>Session not found</h2>

         <a href="/sessions" class="btn btn-primary">
           Return to sessions list
         </a>
       </section>

       <% } %>

     </main>
   </div>

 </body>

 </html>